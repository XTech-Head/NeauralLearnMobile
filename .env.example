# .env.example — copy to .env and fill in. All of these have a free tier.

# ── Firebase (Auth) ──────────────────────────────────────────
# console.firebase.google.com → create project → Build > Authentication
# → Sign-in method → enable "Email/Password"
# → Project settings → General → Your apps → add a Web app → copy config
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ── Supabase (Database) ─────────────────────────────────────
# supabase.com → New project (free tier) → Settings → API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── Gemini (AI tutor) ────────────────────────────────────────
# aistudio.google.com/app/apikey → Create API key (free tier)
EXPO_PUBLIC_GEMINI_API_KEY=
