{
  "expo": {
    "name": "neurallearn-mobile",
    "slug": "neurallearn-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "neurallearnmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow $(PRODUCT_NAME) to use speech recognition.",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to use the microphone."
      }
    },
    "android": {
  "adaptiveIcon": {
    "backgroundColor": "#010107",
    "foregroundImage": "./assets/images/android-icon-foreground.png",
    "backgroundImage": "./assets/images/android-icon-background.png",
    "monochromeImage": "./assets/images/android-icon-monochrome.png"
  },
  
      "predictiveBackGestureEnabled": false,
      "package": "com.xammy_huncho.neurallearnmobile",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.WAKE_LOCK",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "allowBackup": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#010107",
          "dark": { "backgroundColor": "#010107" }
        }
      ],
      "expo-web-browser",
      "expo-font",
      "expo-image",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow NeuralLearn to access your microphone so you can talk to your AI tutor."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow NeuralLearn to access your photos so you can share images with your AI tutor."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#A78BFA"
        }
      ],
      "expo-speech-recognition",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7c900a1f-c986-4dad-ae0a-c61fc18c5c83"
      }
    }
  }
}
